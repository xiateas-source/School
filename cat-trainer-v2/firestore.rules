rules_version = '2';

// Cat Trainer security rules.
//
// Guarantees enforced here (server-side, not just hidden UI):
//  1. Family isolation — only signed-in members of a family can read/write its data.
//  2. Parent-only control — only a parent can change settings, quests (reward
//     definitions), members, pairing codes, apply point/cat rewards, and create
//     point transactions (adjustments, redemptions, and approved quest earnings).
//  3. The child role is limited to its legitimate actions: REQUESTING a quest
//     completion (once per local day, always status 'pending' — it grants nothing
//     until a parent approves), switching the active cat, and buying café items
//     with coins. The child can never raise its own minutes/coins or cat stats.
//  4. Duplicate quest completions can't double-count (deterministic doc id +
//     create-only). Rewards are applied only by the parent's approval.
//
// Note: for a single-household app this covers the realistic threat (a child
// poking the tablet). Fully tamper-proof reward math would move quest completion
// into a Cloud Function (Blaze plan); see REBUILD-NOTES for that optional upgrade.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function pairing(code) {
      return get(/databases/$(database)/documents/pairings/$(code)).data;
    }
    function memberPath(fid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid);
    }
    function isMember(fid) {
      return signedIn() && exists(memberPath(fid));
    }
    function role(fid) {
      return get(memberPath(fid)).data.role;
    }
    function isParent(fid) {
      return isMember(fid) && role(fid) == 'parent';
    }
    function isChild(fid) {
      return isMember(fid) && role(fid) == 'child';
    }
    // A pairing code is valid for a given family + role if it exists, is active,
    // and points at that family with that role. Used to gate self-joining as a
    // child (tablet) or as a co-parent (a second parent, e.g. Abba).
    function validPairing(fid, code, wantRole) {
      return exists(/databases/$(database)/documents/pairings/$(code))
        && pairing(code).active == true
        && pairing(code).familyId == fid
        && pairing(code).role == wantRole;
    }

    // --- Pairing codes (top-level so an un-joined device can look one up) -----
    // Any parent of the target family can create/manage codes for it (so either
    // parent can pair the tablet or invite a co-parent).
    match /pairings/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && isParent(request.resource.data.familyId);
      allow update, delete: if signedIn() && isParent(resource.data.familyId);
    }

    match /families/{fid} {
      // A parent creates their own family; familyId == the parent's uid.
      allow create: if signedIn()
        && fid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(fid);
      allow update, delete: if isParent(fid);

      // --- Membership -------------------------------------------------------
      match /members/{uid} {
        allow read: if isMember(fid);
        // A user may create only their OWN membership, and only via one of:
        allow create: if signedIn()
          && uid == request.auth.uid
          && (
            // 1. The family owner bootstraps their own parent membership at setup.
            (request.resource.data.role == 'parent'
              && get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid)
            // 2. A co-parent joins as parent with an active PARENT invite code.
            || (request.resource.data.role == 'parent'
              && validPairing(fid, request.resource.data.pairingCode, 'parent'))
            // 3. A device joins as child with an active CHILD pairing code.
            || (request.resource.data.role == 'child'
              && validPairing(fid, request.resource.data.pairingCode, 'child'))
          );
        allow update, delete: if isParent(fid);
      }

      // --- Quests (reward definitions — parent only writes) ----------------
      match /quests/{questId} {
        allow read: if isMember(fid);
        allow create, update, delete: if isParent(fid);
      }

      // --- Child profile ---------------------------------------------------
      match /childProfiles/{childId} {
        allow read: if isMember(fid);
        allow create, delete: if isParent(fid);
        // Parent can set anything. The child may change only its active cat — its
        // minutes (available) and coins are frozen for a child write, so rewards
        // land solely through a parent's quest approval, never self-credited.
        allow update: if isParent(fid)
          || (isChild(fid)
              && request.resource.data.available == resource.data.available
              && request.resource.data.coins == resource.data.coins);

        match /cats/{catId} {
          allow read: if isMember(fid);
          allow create: if isParent(fid);
          // Cat progress is a reward — applied only by a parent (quest approval or
          // undo). The child never writes cat stats directly.
          allow update: if isParent(fid);
          allow delete: if isParent(fid);
        }

        match /ownedCafeItems/{itemId} {
          allow read: if isMember(fid);
          // Purchases are create-only (can't be un-bought by the child).
          allow create: if isMember(fid);
          // The child may rearrange / put away their OWN décor (x, y, placed),
          // but the purchase record is immutable: price + purchasedAt must not
          // change, and only a parent can delete an item. Café items grant no
          // points or coins, so this can't be abused for value.
          allow update: if isParent(fid)
            || (isChild(fid)
                && request.resource.data.price == resource.data.price
                && request.resource.data.purchasedAt == resource.data.purchasedAt);
          allow delete: if isParent(fid);
        }
      }

      // --- Point ledger ----------------------------------------------------
      match /pointTransactions/{txnId} {
        allow read: if isMember(fid);
        // Parent-only: every ledger row (adjust / redeem / correction, and the
        // quest-earned row written when the parent approves a completion). The
        // child no longer writes the ledger — earning flows through approval.
        allow create: if isParent(fid);
        // Entries are never edited. A parent may delete an entry (the app
        // reverses its effect on the balance in the same transaction).
        allow update: if false;
        allow delete: if isParent(fid);
      }

      // --- Quest completions (dedupe: one doc id per child+quest+day) -------
      match /questCompletions/{completionId} {
        allow read: if isMember(fid);
        // The child may only FILE a pending request (status 'pending'); it grants
        // nothing until approved. A parent may create/approve/reject freely.
        // Create-only for the child: a second completion for the same id is an
        // update -> denied.
        allow create: if isParent(fid)
          || (isChild(fid) && request.resource.data.status == 'pending');
        // Parent approves (update to 'approved') or rejects (delete).
        allow update, delete: if isParent(fid);
      }
    }
  }
}
